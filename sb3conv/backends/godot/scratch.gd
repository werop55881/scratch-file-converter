#> Scratch semantics helpers (generated by sb3conv - static functions only).
#> Ported faithfully from the Lua runtime: JS-style truthiness, Scratch number
#> formatting, floored mod, inclusive integer random, byte-ish string ops.
class_name Scratch
extends RefCounted

const STAGE_W := 480.0
const STAGE_H := 360.0

const KEY_MAP := {
	KEY_SPACE: "space",
	KEY_LEFT: "left arrow",
	KEY_RIGHT: "right arrow",
	KEY_UP: "up arrow",
	KEY_DOWN: "down arrow",
	KEY_ENTER: "enter",
	KEY_KP_ENTER: "enter",
	KEY_SHIFT: "shift",
}


static func key_to_scratch(event: InputEventKey) -> String:
	var keycode := event.keycode
	if KEY_MAP.has(keycode):
		return KEY_MAP[keycode]
	if keycode >= KEY_A and keycode <= KEY_Z:
		return String.chr("a".unicode_at(0) + (keycode - KEY_A))
	if keycode >= KEY_0 and keycode <= KEY_9:
		return String.chr("0".unicode_at(0) + (keycode - KEY_0))
	return ""


static func s_num(v: Variant) -> float:
	if v is bool:
		return 1.0 if v else 0.0
	if v is int or v is float:
		return float(v)
	if v is Array:
		return 0.0
	if v == null:
		return 0.0
	var text := str(v).strip_edges()
	if text == "":
		return 0.0
	if text == "NaN":
		return NAN
	if text == "Infinity":
		return INF
	if text == "-Infinity":
		return -INF
	return float(text)


static func fmt_number(v: float) -> String:
	if is_nan(v):
		return "NaN"
	if v == INF:
		return "Infinity"
	if v == -INF:
		return "-Infinity"
	if absf(v) < 1e15 and fmod(v, 1.0) == 0.0:
		return str(int(v))
	return str(v)


static func s_str(v: Variant) -> String:
	if v == null:
		return ""
	if v is bool:
		return "true" if v else "false"
	if v is int or v is float:
		return fmt_number(float(v))
	if v is Array:
		var parts: PackedStringArray = PackedStringArray()
		for item in v:
			parts.append(s_str(item))
		return ", ".join(parts)
	return str(v)


static func s_bool(v: Variant) -> bool:
	if v == null:
		return false
	if v is bool:
		return v
	if v is int or v is float:
		var f := float(v)
		return f != 0.0 and not is_nan(f)
	if v is String:
		return v.length() > 0
	if v is Array:
		return v.size() > 0
	return true


static func looks_numeric(v: Variant) -> bool:
	if v is bool:
		return false
	if v is int or v is float:
		return true
	if v is String:
		var text = v.strip_edges()
		if text == "":
			return false
		return text == "NaN" or text.is_valid_float()
	return false


static func both_numeric(a: Variant, b: Variant) -> bool:
	return looks_numeric(a) and looks_numeric(b)


static func s_add(a: Variant, b: Variant) -> float:
	return s_num(a) + s_num(b)


static func s_sub(a: Variant, b: Variant) -> float:
	return s_num(a) - s_num(b)


static func s_mul(a: Variant, b: Variant) -> float:
	return s_num(a) * s_num(b)


static func s_div(a: Variant, b: Variant) -> Variant:
	var an := s_num(a)
	var bn := s_num(b)
	if bn == 0.0 or is_nan(bn):
		if is_nan(an):
			return "NaN"
		if an > 0.0:
			return "Infinity"
		if an < 0.0:
			return "-Infinity"
		return "NaN"
	return an / bn


static func _is_whole(v: float) -> bool:
	return not is_nan(v) and not is_inf(v) and fmod(v, 1.0) == 0.0


static func s_random(a: Variant, b: Variant) -> float:
	var lo := s_num(a)
	var hi := s_num(b)
	if hi < lo:
		var tmp := lo
		lo = hi
		hi = tmp
	if _is_whole(lo) and _is_whole(hi):
		return floorf(randf() * (floorf(hi) - ceilf(lo) + 1.0)) + ceilf(lo)
	return randf() * (hi - lo) + lo


static func s_gt(a: Variant, b: Variant) -> bool:
	if both_numeric(a, b):
		return s_num(a) > s_num(b)
	return s_str(a) > s_str(b)


static func s_lt(a: Variant, b: Variant) -> bool:
	if both_numeric(a, b):
		return s_num(a) < s_num(b)
	return s_str(a) < s_str(b)


static func s_eq(a: Variant, b: Variant) -> bool:
	if both_numeric(a, b):
		var an := s_num(a)
		var bn := s_num(b)
		if is_nan(an) or is_nan(bn):
			return false
		return an == bn
	return s_str(a).to_lower() == s_str(b).to_lower()


static func s_not(a: Variant) -> bool:
	return not s_bool(a)


static func s_and(a: Variant, b: Variant) -> bool:
	return s_bool(a) and s_bool(b)


static func s_or(a: Variant, b: Variant) -> bool:
	return s_bool(a) or s_bool(b)


static func s_join(a: Variant, b: Variant) -> String:
	return s_str(a) + s_str(b)


static func s_letter(index: Variant, text: Variant) -> String:
	var i := int(floorf(s_num(index)))
	var s := s_str(text)
	if is_nan(float(index)) or i < 1 or i > s.length():
		return ""
	return s.substr(i - 1, 1)


static func s_length(v: Variant) -> int:
	return s_str(v).length()


static func s_contains(haystack: Variant, needle: Variant) -> bool:
	return s_str(haystack).to_lower().contains(s_str(needle).to_lower())


static func s_mod(a: Variant, b: Variant) -> float:
	var an := s_num(a)
	var bn := s_num(b)
	if bn == 0.0 or is_nan(bn) or is_nan(an):
		return NAN
	return an - bn * floorf(an / bn)


static func s_round(v: Variant) -> float:
	return floorf(s_num(v) + 0.5)


static func s_mathop(op: String, v: Variant) -> float:
	var n := s_num(v)
	match op:
		"abs":
			return absf(n)
		"floor":
			return floorf(n)
		"ceiling":
			return ceilf(n)
		"sqrt":
			return sqrt(n) if n >= 0.0 else NAN
		"sin":
			return sin(deg_to_rad(n))
		"cos":
			return cos(deg_to_rad(n))
		"tan":
			return tan(deg_to_rad(n))
		"asin":
			return rad_to_deg(asin(n)) if n >= -1.0 and n <= 1.0 else NAN
		"acos":
			return rad_to_deg(acos(n)) if n >= -1.0 and n <= 1.0 else NAN
		"atan":
			return rad_to_deg(atan(n))
		"ln":
			return log(n) if n > 0.0 else NAN
		"log":
			return log(n) / log(10.0) if n > 0.0 else NAN
		"e ^":
			return exp(n)
		"e^":
			return exp(n)
		"10 ^":
			return pow(10.0, n)
		"10^":
			return pow(10.0, n)
	return 0.0


static func atan2_degrees(dx: float, dy: float) -> float:
	# Scratch: 0 = up, 90 = right, clockwise positive.
	return rad_to_deg(atan2(dx, dy))


static func repeat_count(v: Variant) -> int:
	return maxi(0, int(round(s_num(v))))


static func list_index(lst: Variant, index: Variant) -> int:
	if not lst is Array:
		return 0
	var size: int = (lst as Array).size()
	if index is String:
		if index.to_lower() == "last":
			return size
		return 0
	var k := int(floorf(s_num(index)))
	if is_nan(s_num(index)) or is_inf(s_num(index)) or k == 0:
		return 0
	var pos := k if k > 0 else (size + 1 + k)
	if pos >= 1 and pos <= size:
		return pos
	return 0


static func list_item(lst: Variant, index: Variant) -> Variant:
	if not lst is Array:
		return ""
	var pos := list_index(lst, index)
	if pos == 0:
		return ""
	return (lst as Array)[pos - 1]


static func list_delete(lst: Variant, index: Variant) -> void:
	if not lst is Array:
		return
	var arr := lst as Array
	if index is String and str(index).to_lower() == "all":
		arr.clear()
		return
	var pos := list_index(lst, index)
	if pos != 0:
		arr.remove_at(pos - 1)


static func list_clear(lst: Variant) -> void:
	if lst is Array:
		(lst as Array).clear()


static func list_add(lst: Variant, item: Variant) -> void:
	if lst is Array:
		(lst as Array).append(item)


static func list_insert(lst: Variant, index: Variant, item: Variant) -> void:
	if not lst is Array:
		return
	var arr := lst as Array
	if index is String and str(index).to_lower() == "last":
		arr.append(item)
		return
	if not looks_numeric(index):
		return
	var k := int(floorf(s_num(index)))
	if is_nan(s_num(index)) or is_inf(s_num(index)):
		return
	if k < 1 or k > arr.size() + 1:
		return
	arr.insert(k - 1, item)


static func list_replace(lst: Variant, index: Variant, item: Variant) -> void:
	if not lst is Array:
		return
	var pos := list_index(lst, index)
	if pos != 0:
		(lst as Array)[pos - 1] = item


static func list_index_of(lst: Variant, item: Variant) -> Variant:
	if not lst is Array:
		return ""
	var arr := lst as Array
	for i in arr.size():
		if s_eq(arr[i], item):
			return i + 1
	return ""


static func list_length(value: Variant) -> int:
	if value is Array:
		return (value as Array).size()
	if value is String:
		return (value as String).length()
	return 0


static func list_contains(lst: Variant, item: Variant) -> bool:
	if not lst is Array:
		return false
	for entry in lst as Array:
		if s_eq(entry, item):
			return true
	return false


static func s_costume_name(ctx: Variant) -> String:
	var costume = ctx.costume()
	if costume == null:
		return ""
	return str(costume.name)
