#> Scratch runtime for Godot 4 (generated by sb3conv).
#> Faithful port of the Lua/LÖVE runtime: threads are GDScript coroutines that
#> `await tick` (one signal per logical frame); ghost is the only rendered
#> visual effect; collision ignores rotation; procedures are plain calls.
#> Run headless smoke with env SB3CONV_SMOKE=N (prints SMOKE OK, exits 0).
class_name Sb3Runtime
extends Node2D

signal tick

const CLEAR_COLOR := Color(0.059, 0.059, 0.118)
const DEFAULT_FPS := 30
const MAX_CLONES := 300
const MONITOR_BG := Color(0.96, 0.96, 0.96)
const MONITOR_BORDER := Color(0.69, 0.69, 0.69)
const MONITOR_LABEL := Color(0.24, 0.24, 0.24)
const MONITOR_VALUE := Color(0.08, 0.08, 0.08)
const LARGE_COLOR := Color(0.43, 0.9, 1.0)
const BUBBLE_FILL := Color(1, 1, 1)
const BUBBLE_BORDER := Color(0.7, 0.7, 0.7)
const BUBBLE_TEXT := Color(0.08, 0.08, 0.08)
const ASK_BG := Color(0.96, 0.96, 0.96)
const ASK_BORDER := Color(0.63, 0.63, 0.63)
const MISSING_COLOR := Color(0.47, 0.47, 0.63)
const EFFECT_NAMES := ["ghost", "color", "fisheye", "whirl", "pixelate", "mosaic", "brightness"]


class ThreadState:
	extends RefCounted
	var actor = null
	var done := false


class Costume:
	extends RefCounted
	var name := ""
	var costume_id := ""
	var resolution := 1.0
	var cx := 0.0
	var cy := 0.0
	var texture: Texture2D = null
	var image: Image = null
	var missing := false
	var _mask: PackedByteArray = PackedByteArray()
	var _mask_w := 0
	var _mask_h := 0
	var _ml := 0
	var _mt := 0
	var _mr := 0
	var _mb := 0
	var _mask_ready := false

	func width() -> float:
		var img := ensure_image()
		if img == null:
			return 32.0
		return float(img.get_width()) / resolution

	func height() -> float:
		var img := ensure_image()
		if img == null:
			return 32.0
		return float(img.get_height()) / resolution

	func ensure_image() -> Image:
		if image != null:
			return image
		if texture == null:
			return null
		var img := texture.get_image()
		if img == null:
			return null
		if img.is_compressed():
			img.decompress()
		img.convert(Image.FORMAT_RGBA8)
		image = img
		return image

	func ensure_alpha() -> void:
		if _mask_ready:
			return
		_mask_ready = true
		var img := ensure_image()
		if img == null:
			return
		_mask_w = img.get_width()
		_mask_h = img.get_height()
		_mask.resize(_mask_w * _mask_h)
		_ml = _mask_w
		_mt = _mask_h
		_mr = 0
		_mb = 0
		for y in _mask_h:
			for x in _mask_w:
				if img.get_pixel(x, y).a > 0.0:
					_mask[y * _mask_w + x] = 1
					_ml = mini(_ml, x)
					_mt = mini(_mt, y)
					_mr = maxi(_mr, x + 1)
					_mb = maxi(_mb, y + 1)
		if _mr <= _ml:
			_ml = 0
			_mt = 0
			_mr = _mask_w
			_mb = _mask_h


class SoundAsset:
	extends RefCounted
	var name := ""
	var path := ""
	var stream: AudioStream = null


class Actor:
	extends RefCounted
	var rt = null
	var target: Dictionary = {}
	var is_clone := false
	var x := 0.0
	var y := 0.0
	var direction := 90.0
	var size := 100.0
	var visible := true
	var rotation_style := "all around"
	var volume := 100.0
	var current_costume := 0
	var effects := {}
	var sound_effects := {}
	var say = null
	var think = null
	var dead := false
	var vars: Dictionary = {}
	var lists: Dictionary = {}
	var costumes: Array = []
	var sounds: Dictionary = {}

	func _init(rt_owner, def: Dictionary, is_stage := false) -> void:
		rt = rt_owner
		target = def
		vars = def.get("variables", {}) as Dictionary
		lists = def.get("lists", {}) as Dictionary
		costumes = def.get("costumes", []) as Array
		for asset in def.get("sounds", []) as Array:
			sounds[str(asset.name)] = asset
		x = float(def.get("x", 0))
		y = float(def.get("y", 0))
		direction = float(def.get("direction", 90))
		size = float(def.get("size", 100))
		var vis = def.get("visible")
		visible = true if vis == null else bool(vis)
		rotation_style = str(def.get("rotationStyle", "all around"))
		volume = float(def.get("volume", 100))
		current_costume = int(def.get("currentCostume", 0))
		for effect_name in Sb3Runtime.EFFECT_NAMES:
			effects[effect_name] = 0.0
		sound_effects = {"PITCH": 0.0, "PAN": 0.0}

	func costume():
		if costumes.is_empty():
			return null
		var index := int(floorf(current_costume)) % costumes.size()
		if index < 0:
			index += costumes.size()
		return costumes[index]

	func set_costume(ref) -> void:
		if costumes.is_empty():
			return
		if ref is int or ref is float:
			var n := int(floorf(float(ref))) - 1
			n = clampi(n, 0, costumes.size() - 1)
			current_costume = n
			return
		var key := str(ref)
		for i in costumes.size():
			var c = costumes[i]
			if str(c.name) == key or str(c.costume_id) == key:
				current_costume = i
				return
		rt.warn_once("unknown costume " + key)

	func next_costume() -> void:
		if costumes.is_empty():
			return
		current_costume = (int(floorf(current_costume)) + 1) % costumes.size()

	func remove_clone() -> void:
		dead = true

	func half_size() -> Vector2:
		var c = costume()
		if c == null:
			return Vector2(32, 32)
		return Vector2(c.width() * size / 100.0, c.height() * size / 100.0)

	func rect() -> Rect2:
		var c = costume()
		var sc := size / 100.0
		if c != null:
			c.ensure_alpha()
			if c._mask_w > 0:
				var left = floorf(x + (float(c._ml) / c.resolution - c.cx) * sc)
				var top = floorf(y + (c.cy - float(c._mb) / c.resolution) * sc)
				var w = maxf(1.0, floorf((float(c._mr - c._ml) / c.resolution) * sc))
				var h = maxf(1.0, floorf((float(c._mb - c._mt) / c.resolution) * sc))
				return Rect2(left, top, w, h)
		var hw: float = c.width() * sc * 0.5 if c != null else 16.0 * sc
		var hh: float = c.height() * sc * 0.5 if c != null else 16.0 * sc
		return Rect2(floorf(x - hw), floorf(y - hh), maxf(1.0, hw * 2.0), maxf(1.0, hh * 2.0))

	func opaque_at(sx: float, sy: float) -> bool:
		var c = costume()
		if c == null:
			return false
		c.ensure_alpha()
		if c._mask_w == 0:
			return rect().has_point(Vector2(sx, sy))
		var sc := size / 100.0
		if sc <= 0.0:
			return false
		var px := int(floorf(((sx - x) / sc + c.cx) * c.resolution))
		var py := int(floorf((c.cy - (sy - y) / sc) * c.resolution))
		if px < 0 or py < 0 or px >= c._mask_w or py >= c._mask_h:
			return false
		return c._mask[py * c._mask_w + px] == 1

	func overlaps(other) -> bool:
		var ra := rect()
		var rb = other.rect()
		if ra.end.x <= rb.position.x or rb.end.x <= ra.position.x:
			return false
		if ra.end.y <= rb.position.y or rb.end.y <= ra.position.y:
			return false
		var ca = costume()
		var cb = other.costume()
		if ca == null or cb == null:
			return true
		ca.ensure_alpha()
		cb.ensure_alpha()
		if ca._mask_w == 0 or cb._mask_w == 0:
			return true
		var sa := size / 100.0
		var sb = other.size / 100.0
		if sa <= 0.0 or sb <= 0.0:
			return false
		var ax = x - ca.cx * sa
		var ay = y + ca.cy * sa
		var bx = other.x - cb.cx * sb
		var by = other.y + cb.cy * sb
		var pitch = sa / ca.resolution
		var dx := int(floorf((bx - ax) / pitch + 0.5))
		var dy := int(floorf((ay - by) / pitch + 0.5))
		var x0 := maxi(ca._ml, dx + cb._ml)
		var x1 := mini(ca._mr, dx + cb._mr)
		var y0 := maxi(ca._mt, dy + cb._mt)
		var y1 := mini(ca._mb, dy + cb._mb)
		for y in range(y0, y1):
			for x in range(x0, x1):
				if ca._mask[y * ca._mask_w + x] == 1:
					var ox := x - dx
					var oy := y - dy
					if cb._mask[oy * cb._mask_w + ox] == 1:
						return true
		return false


var manifest: Dictionary = {}
var scripts = null
var asset_dir := "assets"
var scale_factor := 2
var fps := DEFAULT_FPS
var frame_time := 1.0 / float(DEFAULT_FPS)
var frame := 0
var timer := 0.0
var answer := ""
var loudness := 100.0
var username := ""
var mouse_x := 0.0
var mouse_y := 0.0
var mouse_down := false
var down_keys := {}
var asking := false
var ask_question := ""
var ask_buffer := ""

var stage_def: Dictionary = {}
var target_defs: Array = []
var stage_actor = null
var actors: Array = []
var layers: Array = []
var vars: Dictionary = {}
var lists: Dictionary = {}

var monitors := {}
var monitor_visible := {}
var list_visible := {}

var routes := {}
var threads: Array = []
var current_thread = null
var nclones := 0

var font: Font = null
var _active_audio: Array = []
var _backdrop_cache := {}
var _acc := 0.0
var warned := {}
var smoke := 0


func _ready() -> void:
	font = ThemeDB.fallback_font
	var text := FileAccess.get_file_as_string("res://manifest.json")
	manifest = JSON.parse_string(text)
	if manifest == null:
		push_error("sb3conv: res://manifest.json is missing or invalid")
		set_process(false)
		return
	asset_dir = str(manifest.get("assetDir", "assets"))
	scale_factor = int(manifest.get("scale", 2))
	fps = maxi(1, int(manifest.get("fps", DEFAULT_FPS)))
	frame_time = 1.0 / float(fps)
	var smoke_text := OS.get_environment("SB3CONV_SMOKE")
	if smoke_text.is_valid_int():
		smoke = int(smoke_text)
	stage_def = _load_target(manifest.get("stage", {}) as Dictionary, true)
	target_defs = [stage_def]
	for entry in manifest.get("sprites", []) as Array:
		target_defs.append(_load_target(entry as Dictionary, false))
	stage_actor = Actor.new(self, stage_def, true)
	actors = [stage_actor]
	for def in target_defs:
		if def == stage_def:
			continue
		actors.append(Actor.new(self, def as Dictionary, false))
	layers = []
	for actor in actors:
		if actor != stage_actor:
			layers.append(actor)
	layers.sort_custom(func(a, b) -> bool:
		return int(a.target.get("layerOrder", 0)) < int(b.target.get("layerOrder", 0))
	)
	vars = stage_def.get("variables", {}) as Dictionary
	lists = stage_def.get("lists", {}) as Dictionary
	for monitor in manifest.get("monitors", []) as Array:
		var m := monitor as Dictionary
		var id := str(m.get("id", ""))
		monitors[id] = m
		monitor_visible[id] = m.get("visible") != false
		if bool(m.get("isList", false)):
			list_visible[id] = m.get("visible") != false
	scripts = load("res://scripts.gd").new()
	routes = _build_routes()
	green_flag()


func _load_target(data: Dictionary, is_stage: bool) -> Dictionary:
	var def := {
		"name": str(data.get("name", "Stage" if is_stage else "Sprite")),
		"is_stage": is_stage,
		"variables": {},
		"lists": {},
		"currentCostume": int(data.get("currentCostume", 0)),
		"volume": float(data.get("volume", 100)),
		"layerOrder": int(data.get("layerOrder", 0)),
		"costumes": [],
		"sounds": [],
		"_sound_map": {},
	}
	var raw_vars := data.get("variables", {}) as Dictionary
	for var_key in raw_vars:
		def["variables"][str(var_key)] = raw_vars[var_key]
	var raw_lists := data.get("lists", {}) as Dictionary
	for list_key in raw_lists:
		def["lists"][str(list_key)] = (raw_lists[list_key] as Array).duplicate(true)
	var costumes: Array = []
	for entry in data.get("costumes", []) as Array:
		var c := entry as Dictionary
		var costume := Costume.new()
		costume.name = str(c.get("name", ""))
		costume.costume_id = str(c.get("id", costume.name))
		costume.resolution = float(c.get("resolution", 1))
		if costume.resolution == 0.0:
			costume.resolution = 1.0
		costume.cx = float(c.get("cx", 0)) / costume.resolution
		costume.cy = float(c.get("cy", 0)) / costume.resolution
		var loaded = load("res://" + asset_dir + "/" + str(c.get("file", "")))
		if loaded is Texture2D:
			costume.texture = loaded
		else:
			costume.missing = true
		costumes.append(costume)
	def["costumes"] = costumes
	var sounds: Array = []
	var sound_map := {}
	for entry in data.get("sounds", []) as Array:
		var s := entry as Dictionary
		var sound := SoundAsset.new()
		sound.name = str(s.get("name", ""))
		sound.path = "res://" + asset_dir + "/" + str(s.get("file", ""))
		var loaded = load(sound.path)
		if loaded is AudioStream:
			sound.stream = loaded
		sounds.append(sound)
		sound_map[sound.name] = sound
	def["sounds"] = sounds
	def["_sound_map"] = sound_map
	if not is_stage:
		def["x"] = float(data.get("x", 0))
		def["y"] = float(data.get("y", 0))
		def["direction"] = float(data.get("direction", 90))
		def["size"] = float(data.get("size", 100))
		var vis = data.get("visible")
		def["visible"] = true if vis == null else bool(vis)
		def["rotationStyle"] = str(data.get("rotationStyle", "all around"))
	return def


func _build_routes() -> Dictionary:
	var result := {
		"flag": [],
		"key": {},
		"click": {},
		"broadcast": {},
		"backdrop": {},
		"clone": {},
		"greater": [],
	}
	var regs = scripts.registrations() if scripts != null and scripts.has_method("registrations") else []
	for entry in regs as Array:
		var reg := entry as Dictionary
		var hat := str(reg.get("hat", ""))
		var fields := reg.get("fields", {}) as Dictionary
		match hat:
			"event_whenflagclicked":
				(result["flag"] as Array).append(reg)
			"event_whenkeypressed":
				var key := str(fields.get("KEY_OPTION", ""))
				if not (result["key"] as Dictionary).has(key):
					(result["key"] as Dictionary)[key] = []
				((result["key"] as Dictionary)[key] as Array).append(reg)
			"event_whenthisspriteclicked":
				var sprite := str(reg.get("sprite", ""))
				if not (result["click"] as Dictionary).has(sprite):
					(result["click"] as Dictionary)[sprite] = []
				((result["click"] as Dictionary)[sprite] as Array).append(reg)
			"event_whenbroadcastreceived":
				var name := str(fields.get("BROADCAST_OPTION", ""))
				if not (result["broadcast"] as Dictionary).has(name):
					(result["broadcast"] as Dictionary)[name] = []
				((result["broadcast"] as Dictionary)[name] as Array).append(reg)
			"event_whenbackdropswitchesto":
				var backdrop := str(fields.get("BACKDROP", ""))
				if not (result["backdrop"] as Dictionary).has(backdrop):
					(result["backdrop"] as Dictionary)[backdrop] = []
				((result["backdrop"] as Dictionary)[backdrop] as Array).append(reg)
			"control_start_as_clone":
				var sprite := str(reg.get("sprite", ""))
				if not (result["clone"] as Dictionary).has(sprite):
					(result["clone"] as Dictionary)[sprite] = []
				((result["clone"] as Dictionary)[sprite] as Array).append(reg)
			"event_whengreaterthan":
				(result["greater"] as Array).append({
					"op": str(fields.get("WHENGREATERTHANOPERATOR", "timer")),
					"threshold": Scratch.s_num(fields.get("WHENGREATERTHANVALUE", 0)),
					"reg": reg,
					"latched": false,
				})
			"procedures_definition":
				pass
			_:
				warn_once("script hat '" + hat + "' is not routed and will never run")
	return result


func warn_once(message: String) -> void:
	if warned.has(message):
		return
	warned[message] = true
	print("warning: " + message)


func unsupported(opcode: String) -> String:
	warn_once("unsupported block: " + opcode)
	return ""


# --- threading -------------------------------------------------------------


func spawn(reg: Dictionary, actor) -> ThreadState:
	if actor == null or actor.dead:
		return null
	var state := ThreadState.new()
	state.actor = actor
	threads.append(state)
	_drive(state, reg)
	return state


func _drive(state: ThreadState, reg: Dictionary) -> void:
	var previous = current_thread
	current_thread = state
	var fn := str(reg.get("fn", ""))
	var args: Array = [state.actor, self]
	args.append_array(reg.get("args", []) as Array)
	await scripts.callv(fn, args)
	current_thread = previous
	state.done = true


func spawn_regs(regs: Array, actor = null) -> Array:
	var started: Array = []
	var snapshot := actors.duplicate()
	for reg in regs:
		var r := reg as Dictionary
		var sprite := str(r.get("sprite", ""))
		if actor != null:
			if not actor.dead and str(actor.target.get("name", "")) == sprite:
				var state := spawn(r, actor)
				if state != null:
					started.append(state)
			continue
		for candidate in snapshot:
			var a = candidate
			if not a.dead and str(a.target.get("name", "")) == sprite:
				var state := spawn(r, a)
				if state != null:
					started.append(state)
	return started


func green_flag() -> void:
	spawn_regs(routes.get("flag", []) as Array)


func broadcast(name: String) -> void:
	spawn_regs(routes.get("broadcast", {}).get(name, []) as Array)


func broadcast_wait(name: String) -> void:
	var started := spawn_regs(routes.get("broadcast", {}).get(name, []) as Array)
	if started.is_empty():
		return
	while true:
		var all_done := true
		for state in started:
			if not (state as ThreadState).done:
				all_done = false
				break
		if all_done:
			return
		await tick


func stop_all() -> void:
	for state in threads:
		(state as ThreadState).done = true
	stop_all_sounds()


func stop_others(actor) -> void:
	for state in threads:
		var t := state as ThreadState
		if t != current_thread and t.actor == actor:
			t.done = true


func stop_script(actor) -> void:
	for state in threads:
		var t := state as ThreadState
		if t.actor == actor:
			t.done = true


func step() -> void:
	frame += 1
	timer += frame_time
	_check_greater_than()
	tick.emit()
	var alive: Array = []
	for state in threads:
		if not (state as ThreadState).done:
			alive.append(state)
	threads = alive
	if smoke > 0 and frame >= smoke:
		print("SMOKE OK frames=%d threads=%d" % [frame, threads.size()])
		get_tree().quit(0)


func _check_greater_than() -> void:
	for entry in routes.get("greater", []) as Array:
		var g := entry as Dictionary
		var value := timer if str(g.get("op", "timer")) == "timer" else loudness
		if value > float(g.get("threshold", 0)) and not bool(g.get("latched", false)):
			g["latched"] = true
			var reg := g.get("reg", {}) as Dictionary
			spawn(reg, _actor_for(str(reg.get("sprite", ""))))
		elif value <= float(g.get("threshold", 0)):
			g["latched"] = false


func _actor_for(sprite: String):
	for actor in actors:
		var a = actor
		if not a.dead and str(a.target.get("name", "")) == sprite and not a.is_clone:
			return a
	for actor in actors:
		var a = actor
		if not a.dead and str(a.target.get("name", "")) == sprite:
			return a
	return null


func _process(delta: float) -> void:
	_update_mouse()
	_acc += delta
	var guard := 0
	while _acc >= frame_time and guard < 10:
		_acc -= frame_time
		step()
		guard += 1
	queue_redraw()


# --- waits -----------------------------------------------------------------


func wait_secs(seconds) -> void:
	var frames := maxi(1, int(floorf(Scratch.s_num(seconds) * float(fps) + 0.5)))
	for i in frames:
		await tick


func glide_to(ctx, seconds, target_x: float, target_y: float) -> void:
	var frames := maxi(1, int(floorf(Scratch.s_num(seconds) * float(fps) + 0.5)))
	var x0 = ctx.x
	var y0 = ctx.y
	for i in range(1, frames + 1):
		var t := float(i) / float(frames)
		ctx.x = x0 + (target_x - x0) * t
		ctx.y = y0 + (target_y - y0) * t
		await tick


func ask(question) -> void:
	ask_question = Scratch.s_str(question)
	ask_buffer = ""
	asking = true
	while asking:
		await tick


# --- motion ----------------------------------------------------------------


func norm_dir(direction: float) -> float:
	var d := fmod(direction + 180.0, 360.0)
	if d < 0.0:
		d += 360.0
	return d - 180.0


func tx(ref) -> float:
	var key := Scratch.s_str(ref)
	if key == "_mouse_":
		return mouse_x
	var actor = _visible_actor(key, null)
	return actor.x if actor != null else 0.0


func ty(ref) -> float:
	var key := Scratch.s_str(ref)
	if key == "_mouse_":
		return mouse_y
	var actor = _visible_actor(key, null)
	return actor.y if actor != null else 0.0


func move(ctx, steps) -> void:
	var radians = deg_to_rad(90.0 - ctx.direction)
	ctx.x += cos(radians) * Scratch.s_num(steps)
	ctx.y += sin(radians) * Scratch.s_num(steps)


func point_towards(ctx, ref) -> void:
	var key := Scratch.s_str(ref)
	var target_x := mouse_x
	var target_y := mouse_y
	if key != "_mouse_":
		var actor = _visible_actor(key, null)
		if actor != null:
			target_x = actor.x
			target_y = actor.y
	ctx.direction = norm_dir(Scratch.atan2_degrees(target_x - ctx.x, target_y - ctx.y))


func goto_xy(ctx, target_x: float, target_y: float) -> void:
	ctx.x = target_x
	ctx.y = target_y


func goto_target(ctx, ref) -> void:
	var key := Scratch.s_str(ref)
	if key == "_mouse_":
		ctx.x = mouse_x
		ctx.y = mouse_y
		return
	for part in key.split(","):
		var actor = _visible_actor(part.strip_edges(), ctx)
		if actor != null:
			ctx.x = actor.x
			ctx.y = actor.y
			return


func bounce(ctx) -> void:
	var r = ctx.rect()
	if r.position.x < -240.0:
		ctx.direction = norm_dir(0.0 - ctx.direction)
		ctx.x += -240.0 - r.position.x
	elif r.end.x > 240.0:
		ctx.direction = norm_dir(0.0 - ctx.direction)
		ctx.x += 240.0 - r.end.x
	if r.position.y > 180.0:
		ctx.direction = norm_dir(180.0 - ctx.direction)
		ctx.y += 180.0 - r.position.y
	elif r.end.y < -180.0:
		ctx.direction = norm_dir(180.0 - ctx.direction)
		ctx.y += -180.0 - r.end.y


# --- looks -----------------------------------------------------------------


func clamp_size(value: float) -> float:
	return clampf(value, 10.0, 10000.0)


func clamp_volume(value) -> float:
	return clampf(Scratch.s_num(value), 0.0, 100.0)


func set_costume(ctx, ref) -> void:
	ctx.set_costume(ref)


func next_costume(ctx) -> void:
	ctx.next_costume()


func set_size(ctx, value) -> void:
	ctx.size = clamp_size(Scratch.s_num(value))


func change_size(ctx, delta) -> void:
	ctx.size = clamp_size(ctx.size + Scratch.s_num(delta))


func set_effect(ctx, effect: String, value) -> void:
	ctx.effects[effect] = Scratch.s_num(value)
	if effect != "ghost":
		warn_once("visual effect '" + effect + "' is stored but not rendered by the Godot runtime")


func change_effect(ctx, effect: String, delta) -> void:
	set_effect(ctx, effect, float(ctx.effects.get(effect, 0.0)) + Scratch.s_num(delta))


func clear_effects(ctx) -> void:
	for effect_name in EFFECT_NAMES:
		ctx.effects[effect_name] = 0.0


func say(ctx, text) -> void:
	ctx.say = text
	ctx.think = null


func think(ctx, text) -> void:
	ctx.think = text
	ctx.say = null


func go_to_front(ctx) -> void:
	layers.erase(ctx)
	layers.append(ctx)


func go_to_back(ctx) -> void:
	layers.erase(ctx)
	layers.insert(0, ctx)


func go_layer(ctx, n: int) -> void:
	layers.erase(ctx)
	layers.insert(clampi(n - 1, 0, layers.size()), ctx)


func go_layer_relative(ctx, n: int) -> void:
	var index := layers.find(ctx)
	if index < 0:
		return
	layers.remove_at(index)
	layers.insert(clampi(index + n, 0, layers.size()), ctx)


# --- backdrop --------------------------------------------------------------


func set_backdrop(name) -> void:
	var key := Scratch.s_str(name)
	var costumes := stage_def.get("costumes", []) as Array
	for i in costumes.size():
		if str((costumes[i] as Costume).name) == key:
			if int(stage_actor.current_costume) != i:
				stage_actor.current_costume = i
				_fire_backdrop_hats()
			return
	warn_once("unknown backdrop " + key)


func next_backdrop() -> void:
	var costumes := stage_def.get("costumes", []) as Array
	if costumes.is_empty():
		return
	stage_actor.current_costume = (int(stage_actor.current_costume) + 1) % costumes.size()
	_fire_backdrop_hats()


func _fire_backdrop_hats() -> void:
	var costumes := stage_def.get("costumes", []) as Array
	if costumes.is_empty():
		return
	var current: Costume = costumes[int(stage_actor.current_costume) % costumes.size()]
	spawn_regs(routes.get("backdrop", {}).get(current.name, []) as Array)


# --- sound -----------------------------------------------------------------


func play_sound(ctx, name):
	var key := Scratch.s_str(name)
	var asset = ctx.sounds.get(key)
	if asset == null or asset.stream == null:
		warn_once("unknown sound " + key)
		return null
	var player := AudioStreamPlayer.new()
	add_child(player)
	player.stream = asset.stream
	var linear = clampf(ctx.volume / 100.0, 0.0, 1.0)
	player.volume_db = linear_to_db(maxf(0.0001, linear))
	player.pitch_scale = maxf(0.05, (100.0 + float(ctx.sound_effects.get("PITCH", 0.0))) / 100.0)
	player.play()
	_active_audio.append(player)
	return player


func play_until_done(ctx, name) -> void:
	var player = play_sound(ctx, name)
	if player == null:
		return
	while player.playing:
		await tick


func stop_all_sounds() -> void:
	for entry in _active_audio:
		var player := entry as AudioStreamPlayer
		if is_instance_valid(player):
			player.stop()
			player.queue_free()
	_active_audio.clear()


func change_sound_effect(ctx, effect: String, delta) -> void:
	var key := effect.to_upper()
	ctx.sound_effects[key] = float(ctx.sound_effects.get(key, 0.0)) + Scratch.s_num(delta)
	if key != "PITCH":
		warn_once("sound effect '" + effect + "' has no audible effect")


func set_sound_effect(ctx, effect: String, value) -> void:
	ctx.sound_effects[effect.to_upper()] = Scratch.s_num(value)


func clear_sound_effects(ctx) -> void:
	ctx.sound_effects = {"PITCH": 0.0, "PAN": 0.0}


# --- sensing ---------------------------------------------------------------


func key_down(key: String) -> bool:
	if key == "any":
		return not down_keys.is_empty()
	return bool(down_keys.get(key, false))


func _visible_actor(name: String, exclude):
	for i in range(layers.size() - 1, -1, -1):
		var a = layers[i]
		if a != exclude and not a.dead and a.visible and str(a.target.get("name", "")) == name:
			return a
	return null


func touching(ctx, ref) -> bool:
	var key := Scratch.s_str(ref)
	if key == "_edge_":
		var r = ctx.rect()
		return r.position.x <= -240.0 or r.end.x >= 240.0 or r.position.y >= 180.0 or r.end.y <= -180.0
	if key == "_mouse_":
		return ctx.opaque_at(mouse_x, mouse_y)
	var other = _visible_actor(key, ctx)
	if other == null:
		return false
	return ctx.overlaps(other)


func distance_to(ctx, ref) -> float:
	var dx = tx(ref) - ctx.x
	var dy = ty(ref) - ctx.y
	return sqrt(dx * dx + dy * dy)


func parse_colour(text) -> String:
	var s := Scratch.s_str(text).strip_edges()
	if s.begins_with("#"):
		s = s.substr(1)
	if s.length() == 3:
		var expanded := ""
		for i in 3:
			var ch := s.substr(i, 1)
			expanded += ch + ch
		s = expanded
	if s.length() != 6:
		return ""
	for i in 6:
		var code := s.unicode_at(i)
		var ok := (code >= 48 and code <= 57) or (code >= 97 and code <= 102) or (code >= 65 and code <= 70)
		if not ok:
			return ""
	var r := int("0x" + s.substr(0, 2))
	var g := int("0x" + s.substr(2, 2))
	var b := int("0x" + s.substr(4, 2))
	return "%d,%d,%d" % [r, g, b]


func _rgb_key(color: Color) -> String:
	return "%d,%d,%d" % [int(color.r * 255.0 + 0.5), int(color.g * 255.0 + 0.5), int(color.b * 255.0 + 0.5)]


func touching_colour(ctx, colour) -> bool:
	var target := parse_colour(colour)
	if target == "":
		return false
	return _probe(ctx, func(key: String) -> bool: return key == target, target)


func colour_touching_colour(ctx, first, second) -> bool:
	var c1 := parse_colour(first)
	var c2 := parse_colour(second)
	if c1 == "" or c2 == "":
		return false
	return _probe(ctx, func(key: String) -> bool: return key == c1, c2)


func _actor_pixel(ctx, px: int, py: int) -> Color:
	var c = ctx.costume()
	if c == null:
		return Color(0, 0, 0, 0)
	var img = c.ensure_image()
	if img == null:
		return Color(0, 0, 0, 0)
	var sc = ctx.size / 100.0
	if sc <= 0.0:
		return Color(0, 0, 0, 0)
	var sx := float(px) + 0.5
	var sy := float(py) + 0.5
	var u = ((sx - 240.0 - ctx.x) / sc + c.cx) * c.resolution
	var v = (c.cy - ((180.0 - sy) - ctx.y) / sc) * c.resolution
	var ix := int(floorf(u))
	var iy := int(floorf(v))
	if ix < 0 or iy < 0 or ix >= img.get_width() or iy >= img.get_height():
		return Color(0, 0, 0, 0)
	return img.get_pixel(ix, iy)


func _probe(ctx, matches_actor_pixel: Callable, target: String) -> bool:
	var backdrop_image := _backdrop_image()
	for py in range(0, 360, 4):
		for px in range(0, 480, 4):
			var color := _actor_pixel(ctx, px, py)
			if color.a < 0.5:
				continue
			if matches_actor_pixel.call(_rgb_key(color)) and _colour_at(px, py, backdrop_image) == target:
				return true
	return false


func _colour_at(px: int, py: int, backdrop_image: Image) -> String:
	if backdrop_image != null and px < backdrop_image.get_width() and py < backdrop_image.get_height():
		var back := backdrop_image.get_pixel(px, py)
		if back.a >= 0.5:
			return _rgb_key(back)
	for i in range(layers.size() - 1, -1, -1):
		var a = layers[i]
		if a.dead or not a.visible:
			continue
		var c = a.costume()
		if c == null:
			continue
		var img = c.ensure_image()
		if img == null:
			continue
		# faithful quirk: raw costume pixels, no position/scale transform
		if px < img.get_width() and py < img.get_height():
			var color = img.get_pixel(px, py)
			if color.a >= 0.5:
				return _rgb_key(color)
	return ""


func _backdrop_image() -> Image:
	var costumes := stage_def.get("costumes", []) as Array
	if costumes.is_empty():
		return null
	var index := int(stage_actor.current_costume)
	if _backdrop_cache.get("index", -1) == index:
		return _backdrop_cache.get("image")
	var c: Costume = costumes[index % costumes.size()]
	var img = c.ensure_image()
	_backdrop_cache = {"index": index, "image": img}
	return img


func of(attribute, obj):
	var attr := Scratch.s_str(attribute)
	var key := Scratch.s_str(obj)
	if key == "_mouse_":
		if attr == "x position":
			return mouse_x
		if attr == "y position":
			return mouse_y
		return 0.0
	if attr == "backdrop":
		var costumes := stage_def.get("costumes", []) as Array
		if costumes.is_empty():
			return ""
		return (costumes[int(stage_actor.current_costume) % costumes.size()] as Costume).name
	var actor = _visible_actor(key, null)
	if actor == null:
		return ""
	match attr:
		"x position":
			return actor.x
		"y position":
			return actor.y
		"direction":
			return actor.direction
		"size":
			return actor.size
		"volume":
			return actor.volume
		"costume #":
			return int(actor.current_costume) + 1
		"costume name":
			return Scratch.s_costume_name(actor)
		"loudness":
			return loudness
	return ""


func reset_timer() -> void:
	timer = 0.0


# --- monitors --------------------------------------------------------------


func set_monitor_visible(id: String, visible: bool) -> void:
	if not monitor_visible.has(id):
		warn_once("unknown monitor " + id)
		return
	monitor_visible[id] = visible


func set_list_visible(id: String, visible: bool) -> void:
	if not list_visible.has(id) and not monitor_visible.has(id):
		for key in monitors:
			if bool((monitors[key] as Dictionary).get("isList", false)):
				list_visible[key] = true
		return
	list_visible[id] = visible


# --- clones ----------------------------------------------------------------


func create_clone(ctx, target_name = "") -> void:
	if nclones >= MAX_CLONES:
		warn_once("clone limit reached")
		return
	var source = ctx
	var key := Scratch.s_str(target_name)
	if key != "" and key != "_myself_" and key != "myself" and key != str(ctx.target.get("name", "")):
		var found = _visible_actor(key, null)
		if found == null:
			found = _actor_for(key)
		if found == null:
			warn_once("unknown clone target " + key)
			return
		source = found
	var clone := Actor.new(self, source.target, false)
	clone.is_clone = true
	clone.x = source.x
	clone.y = source.y
	clone.direction = source.direction
	clone.size = source.size
	clone.visible = source.visible
	clone.rotation_style = source.rotation_style
	clone.volume = source.volume
	clone.current_costume = source.current_costume
	clone.effects = source.effects.duplicate()
	clone.sound_effects = source.sound_effects.duplicate()
	clone.say = source.say
	clone.think = source.think
	clone.vars = source.vars.duplicate()
	clone.lists = {}
	for list_key in source.lists:
		clone.lists[list_key] = (source.lists[list_key] as Array).duplicate()
	actors.append(clone)
	var index := layers.find(source)
	if index >= 0:
		layers.insert(index + 1, clone)
	else:
		layers.append(clone)
	nclones += 1
	for reg in routes.get("clone", {}).get(str(clone.target.get("name", "")), []) as Array:
		spawn(reg as Dictionary, clone)


func remove_clone(ctx) -> void:
	if not ctx.is_clone:
		return
	ctx.dead = true
	layers.erase(ctx)
	nclones = maxi(0, nclones - 1)


# --- drawing ---------------------------------------------------------------


func _draw() -> void:
	draw_rect(Rect2(0, 0, Scratch.STAGE_W, Scratch.STAGE_H), CLEAR_COLOR)
	var costumes := stage_def.get("costumes", []) as Array
	if not costumes.is_empty():
		var backdrop: Costume = costumes[int(stage_actor.current_costume) % costumes.size()]
		if backdrop.texture != null:
			draw_texture_rect(backdrop.texture, Rect2(0, 0, Scratch.STAGE_W, Scratch.STAGE_H), false)
	for actor in layers:
		var a = actor
		if not a.dead and a.visible:
			_draw_actor(a)
	for actor in layers:
		var a = actor
		if not a.dead and (a.say != null or a.think != null):
			_draw_bubble(a)
	if stage_actor.say != null or stage_actor.think != null:
		_draw_bubble(stage_actor)
	_draw_monitors()
	if asking:
		_draw_ask()


func _cv(x: float, y: float) -> Vector2:
	return Vector2(x + Scratch.STAGE_W * 0.5, Scratch.STAGE_H * 0.5 - y)


func _draw_actor(ctx) -> void:
	var c = ctx.costume()
	var sc = ctx.size / 100.0
	var center := _cv(ctx.x, ctx.y)
	var rot := 0.0
	var mirror := Vector2(1, 1)
	if ctx.rotation_style == "all around":
		rot = deg_to_rad(ctx.direction - 90.0)
	elif ctx.rotation_style == "left-right" and ctx.direction < 0.0:
		mirror = Vector2(-1, 1)
	var alpha = clampf(1.0 - float(ctx.effects.get("ghost", 0.0)) / 100.0, 0.0, 1.0)
	var color := Color(1, 1, 1, alpha)
	if c != null and c.texture != null:
		var w = c.width() * sc
		var h = c.height() * sc
		var top_left := Vector2(-c.cx * sc, -c.cy * sc)
		draw_set_transform(center, rot, mirror)
		draw_texture_rect(c.texture, Rect2(top_left, Vector2(w, h)), false, color)
	else:
		var side = 32.0 * sc
		draw_set_transform(center, 0, Vector2(1, 1))
		draw_rect(
			Rect2(Vector2(-side * 0.5, -side * 0.5), Vector2(side, side)),
			Color(MISSING_COLOR.r, MISSING_COLOR.g, MISSING_COLOR.b, alpha)
		)
	draw_set_transform(Vector2.ZERO, 0, Vector2(1, 1))


func _wrap_text(text: String, limit: int) -> PackedStringArray:
	var lines := PackedStringArray()
	for paragraph in text.split("\n"):
		var words := paragraph.split(" ", false)
		var line := ""
		for word in words:
			if line.length() == 0:
				line = word
			elif line.length() + 1 + word.length() <= limit:
				line += " " + word
			else:
				lines.append(line)
				line = word
		lines.append(line)
	if lines.is_empty():
		lines.append("")
	return lines


func _draw_bubble(ctx) -> void:
	var text := Scratch.s_str(ctx.say if ctx.say != null else ctx.think)
	if text.length() == 0:
		return
	var lines := _wrap_text(text, 24)
	var line_h := 16.0
	var width := 0.0
	for line in lines:
		width = maxf(width, font.get_string_size(line, HORIZONTAL_ALIGNMENT_LEFT, -1, 12).x)
	var box_w := width + 14.0
	var box_h := line_h * lines.size() + 8.0
	var half = ctx.half_size() * 0.5
	var raw := _cv(ctx.x, ctx.y + half.y)
	var by := maxf(raw.y - box_h - 12.0, 4.0)
	var bx := clampf(raw.x - box_w * 0.5, 4.0, Scratch.STAGE_W - box_w - 4.0)
	draw_rect(Rect2(bx, by, box_w, box_h), BUBBLE_FILL)
	draw_rect(Rect2(bx, by, box_w, box_h), BUBBLE_BORDER, false, 1.0)
	for i in lines.size():
		var text_y := by + 4.0 + line_h * 0.75 + line_h * i
		draw_string(font, Vector2(bx + 7.0, text_y), lines[i], HORIZONTAL_ALIGNMENT_LEFT, -1, 12, BUBBLE_TEXT)
	var pointer := PackedVector2Array([
		Vector2(raw.x - 6.0, by + box_h),
		Vector2(raw.x + 6.0, by + box_h),
		Vector2(raw.x, by + box_h + 8.0),
	])
	draw_colored_polygon(pointer, BUBBLE_FILL)


func _monitor_value(m: Dictionary):
	var label := str(m.get("label", ""))
	var target = m.get("target")
	for def in target_defs:
		var d := def as Dictionary
		if target == null or str(target) == str(d.get("name", "")):
			if bool(m.get("isList", false)):
				if (d.get("lists", {}) as Dictionary).has(label):
					return (d.get("lists") as Dictionary)[label]
			else:
				if (d.get("variables", {}) as Dictionary).has(label):
					return (d.get("variables") as Dictionary)[label]
	if bool(m.get("isList", false)):
		return []
	if vars.has(label):
		return vars[label]
	return m.get("value", 0)


func _draw_monitors() -> void:
	for key in monitors:
		var m := monitors[key] as Dictionary
		var id := str(m.get("id", ""))
		var show := bool(list_visible.get(id, false)) if bool(m.get("isList", false)) else bool(monitor_visible.get(id, false))
		if not show:
			continue
		var value = _monitor_value(m)
		var pos := _cv(Scratch.s_num(m.get("x", 0)), Scratch.s_num(m.get("y", 0)))
		if str(m.get("mode", "default")) == "large":
			var text := Scratch.s_str(value)
			draw_string(font, Vector2(pos.x + 2.0, pos.y + 42.0), text, HORIZONTAL_ALIGNMENT_LEFT, -1, 36, Color(0, 0, 0, 0.5))
			draw_string(font, Vector2(pos.x, pos.y + 40.0), text, HORIZONTAL_ALIGNMENT_LEFT, -1, 36, LARGE_COLOR)
			continue
		var label := str(m.get("label", ""))
		var value_text := Scratch.s_str(value)
		var label_w := font.get_string_size(label, HORIZONTAL_ALIGNMENT_LEFT, -1, 12).x
		var value_w := font.get_string_size(value_text, HORIZONTAL_ALIGNMENT_LEFT, -1, 12).x
		var box_w := label_w + value_w + 22.0
		draw_rect(Rect2(pos, Vector2(box_w, 20.0)), MONITOR_BG)
		draw_rect(Rect2(pos, Vector2(box_w, 20.0)), MONITOR_BORDER, false, 1.0)
		draw_string(font, Vector2(pos.x + 6.0, pos.y + 15.0), label, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, MONITOR_LABEL)
		draw_string(font, Vector2(pos.x + box_w - value_w - 6.0, pos.y + 15.0), value_text, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, MONITOR_VALUE)


func _draw_ask() -> void:
	var bar := Rect2(0, Scratch.STAGE_H - 60.0, Scratch.STAGE_W, 60.0)
	draw_rect(bar, ASK_BG)
	draw_rect(bar, ASK_BORDER, false, 1.0)
	var question := ask_question
	if question.length() > 90:
		question = question.substr(0, 90)
	draw_string(font, Vector2(8.0, Scratch.STAGE_H - 40.0), question, HORIZONTAL_ALIGNMENT_LEFT, -1, 12, MONITOR_VALUE)
	draw_string(font, Vector2(8.0, Scratch.STAGE_H - 18.0), ask_buffer + "_", HORIZONTAL_ALIGNMENT_LEFT, -1, 12, MONITOR_VALUE)


# --- input -----------------------------------------------------------------


func _update_mouse() -> void:
	var pos := get_viewport().get_mouse_position()
	mouse_x = pos.x - Scratch.STAGE_W * 0.5
	mouse_y = Scratch.STAGE_H * 0.5 - pos.y
	mouse_down = Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT)


func _fire_click() -> void:
	for i in range(layers.size() - 1, -1, -1):
		var a = layers[i]
		if a.dead or not a.visible:
			continue
		if a.opaque_at(mouse_x, mouse_y):
			spawn_regs(routes.get("click", {}).get(str(a.target.get("name", "")), []) as Array, a)
			return


func _input(event: InputEvent) -> void:
	if event is InputEventKey:
		var key := event as InputEventKey
		if asking:
			if key.pressed and not key.echo:
				if key.keycode == KEY_ENTER or key.keycode == KEY_KP_ENTER:
					answer = ask_buffer
					asking = false
				elif key.keycode == KEY_BACKSPACE:
					if ask_buffer.length() > 0:
						ask_buffer = ask_buffer.substr(0, ask_buffer.length() - 1)
				elif key.unicode >= 32:
					ask_buffer += String.chr(key.unicode)
			return
		var name := Scratch.key_to_scratch(key)
		if name == "":
			return
		if key.pressed and not key.echo:
			down_keys[name] = true
			var by_key = routes.get("key", {})
			spawn_regs(by_key.get(name, []) as Array)
			spawn_regs(by_key.get("any", []) as Array)
		elif not key.pressed:
			down_keys.erase(name)
	elif event is InputEventMouseMotion:
		var motion := event as InputEventMouseMotion
		mouse_x = motion.position.x - Scratch.STAGE_W * 0.5
		mouse_y = Scratch.STAGE_H * 0.5 - motion.position.y
	elif event is InputEventMouseButton:
		var button := event as InputEventMouseButton
		mouse_x = button.position.x - Scratch.STAGE_W * 0.5
		mouse_y = Scratch.STAGE_H * 0.5 - button.position.y
		if button.pressed:
			_fire_click()
